# Add these server-only variables in Railway for the live environment.
# Use a separate verified sender and URL for staging.
APP_BASE_URL=https://nehrat-production.up.railway.app
MAIL_FROM=
# Resend: a sending API key and an address on a verified Resend domain.
RESEND_API_KEY=
# Optional alternative for an existing SMTP provider; ignored when Resend is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
