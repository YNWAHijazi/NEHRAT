{
  "name": "moph-readiness-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify && next build",
    "start": "next start",
    "verify": "tsc --noEmit && vitest run && playwright test --project=reference && playwright test --project=app",
    "test": "vitest run",
    "test:watch": "vitest",
    "rules:regenerate": "python3 scripts/extract-reference.py",
    "test:e2e": "playwright test --project=reference && playwright test --project=app",
    "e2e:install": "playwright install chromium",
    "dev:e2e": "rm -f var/e2e.db* && next dev"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
